{
  "uid": "kafka",
  "title": "10 \u00b7 Kafka",
  "tags": [
    "monitoring-lab"
  ],
  "schemaVersion": 39,
  "version": 5,
  "editable": false,
  "style": "dark",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "links": [
    {
      "title": "\u2190 Overview",
      "url": "/d/overview",
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Brokers alive",
      "description": "Reported by the otel kafkametrics receiver (kafka admin protocol). Expected: 2. Yellow at 1 = degraded but functional, red at 0 = topic offline.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(kafka_brokers)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-red",
                "value": 0
              },
              {
                "color": "semi-dark-yellow",
                "value": 1
              },
              {
                "color": "semi-dark-green",
                "value": 2
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "clicks partitions",
      "description": "Partition count on the clicks topic (static at topic creation). Expected: 4 — sets the parallelism ceiling for the Spark Kafka consumer.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(kafka_topic_partitions{topic=\"clicks\"})",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Max lag (any partition)",
      "description": "The single most-behind partition. This is the leading signal for Scenario A.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(kafka_consumer_records_lag_max)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-green",
                "value": 0
              },
              {
                "color": "semi-dark-yellow",
                "value": 5000
              },
              {
                "color": "semi-dark-red",
                "value": 50000
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Records consumed / sec",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(kafka_consumer_records_consumed_total[1m]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Consumer lag over time (per partition)",
      "description": "Trend view. If lag climbs across all partitions evenly \u2192 throughput problem on the consumer (Spark) side. If only one climbs \u2192 broker partition issue. Snapshot of the same data is on the right.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (partition) (kafka_consumer_records_lag{topic=\"clicks\"})",
          "refId": "A",
          "legendFormat": "p{{partition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "opacity",
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Consumer lag right now (per partition)",
      "description": "Snapshot view of the per-partition lag — same data as the timeseries on the left, condensed to a single bar per partition. Green < 5k, yellow < 50k, red beyond.",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (partition) (kafka_consumer_records_lag{topic=\"clicks\"})",
          "refId": "A",
          "legendFormat": "p{{partition}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-green",
                "value": 0
              },
              {
                "color": "semi-dark-yellow",
                "value": 5000
              },
              {
                "color": "semi-dark-red",
                "value": 50000
              }
            ]
          }
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Production rate (partition offset growth)",
      "description": "How fast new messages arrive \u2014 derivative of the high-watermark offset.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (partition) (deriv(kafka_partition_current_offset_ratio{topic=\"clicks\"}[1m]))",
          "refId": "A",
          "legendFormat": "p{{partition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Consumer fetch latency",
      "description": "Time the Spark Kafka consumer spends waiting on a fetch from a broker. Spikes = broker pressure or network. Two series: max (worst executor in window) and avg (across all executors).",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(kafka_consumer_fetch_latency_max)",
          "refId": "A",
          "legendFormat": "max"
        },
        {
          "expr": "avg(kafka_consumer_fetch_latency_avg)",
          "refId": "B",
          "legendFormat": "avg"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      }
    }
  ]
}