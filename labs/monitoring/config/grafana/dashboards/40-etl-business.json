{
  "uid": "etl",
  "title": "40 \u00b7 ETL Business",
  "tags": [
    "monitoring-lab"
  ],
  "schemaVersion": 39,
  "version": 4,
  "editable": false,
  "style": "dark",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "links": [
    {
      "title": "\u2190 Overview",
      "url": "/d/overview",
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Epochs succeeded (1h)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"etl\"} |= \"epoch done\" [1h]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-green"
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Epochs failed (1h)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"etl\"} |= \"epoch failed\" [1h]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-green",
                "value": 0
              },
              {
                "color": "semi-dark-red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Schema-drop WARNs (1h)",
      "description": "Number of micro-batches in the last hour that emitted a 'dropped N records missing product_id' WARN. > 0 = upstream data quality issue. To see the actual dropped record counts, expand a line in the log panels below.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"etl\"} |= \"dropped\" |= \"missing product_id\" [1h]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-green",
                "value": 0
              },
              {
                "color": "semi-dark-yellow",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Epochs in last 10m",
      "description": "Count of 'epoch done' log lines in the last 10 minutes \u2014 i.e. how many micro-batches the streaming query completed. Expected \u2248 10 at a 60s trigger.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"etl\"} |= \"epoch done\" [10m]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Epoch outcomes \u2014 done vs failed",
      "description": "Each bar is one micro-batch (epoch). Red bars = epochs that failed.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"etl\"} |= \"epoch done\" [1m]))",
          "refId": "A",
          "legendFormat": "done"
        },
        {
          "expr": "sum(count_over_time({service_name=\"etl\"} |= \"epoch failed\" [1m]))",
          "refId": "B",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "drawStyle": "bars",
            "barAlignment": -1,
            "stacking": {
              "mode": "none"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "done"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "semi-dark-green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "semi-dark-red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Schema-drop WARNs / sec",
      "description": "Rate of 'dropped … missing product_id' WARN log lines. Each line represents one micro-batch (not one record) — for the per-batch record count, expand the line. Spikes here are exactly Scenario B (producer inject-bad).",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(rate({service_name=\"etl\"} |= \"dropped\" |= \"missing product_id\" [1m]))",
          "refId": "A",
          "legendFormat": "dropped"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-orange"
          }
        }
      }
    },
    {
      "id": 20,
      "type": "logs",
      "title": "All ETL log lines \u2014 click a batch_id chip to pivot to Tempo",
      "description": "Hover a line and use the inline batch_id link to open the corresponding etl_batch trace.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=\"etl\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "showLabels": false,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 30,
      "type": "logs",
      "title": "Only WARN + ERROR",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=\"etl\"} | json | level=~\"WARNING|ERROR\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "showLabels": false,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}