{
  "uid": "spark",
  "title": "20 \u00b7 Spark",
  "tags": [
    "monitoring-lab"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "style": "dark",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "links": [
    {
      "title": "\u2190 Overview",
      "url": "/d/overview",
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Live executors",
      "description": "Drops during Scenario C (docker kill spark-worker-1).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(count by (host_name) (jvm_memory_used_bytes{service_name=\"spark-executor\"}))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-red",
                "value": 0
              },
              {
                "color": "semi-dark-yellow",
                "value": 1
              },
              {
                "color": "semi-dark-green",
                "value": 2
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Driver heap usage",
      "description": "Heap used / heap max, on the streaming-query driver JVM. Should sit well below 70% steady-state; the state store (a few open windows × 20 products) is tiny. Yellow > 70%, red > 90% indicates leak or under-sized driver.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{service_name=\"spark-driver\",jvm_memory_type=\"heap\"}) / sum(jvm_memory_limit_bytes{service_name=\"spark-driver\",jvm_memory_type=\"heap\"})",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-green",
                "value": 0
              },
              {
                "color": "semi-dark-yellow",
                "value": 0.7
              },
              {
                "color": "semi-dark-red",
                "value": 0.9
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Driver GC time / min",
      "description": "High GC = driver heap pressure \u2192 slow batches.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(jvm_gc_duration_seconds_sum{service_name=\"spark-driver\"}[2m])) * 60",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-green",
                "value": 0
              },
              {
                "color": "semi-dark-yellow",
                "value": 1
              },
              {
                "color": "semi-dark-red",
                "value": 10
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Driver CPU",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(jvm_cpu_recent_utilization_ratio{service_name=\"spark-driver\"})",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "JVM heap used \u2014 driver vs each executor",
      "description": "Executor heap spikes correlate with stage activity. Driver heap should stay flat.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (service_name, host_name) (jvm_memory_used_bytes{service_name=~\"spark-.*\",jvm_memory_type=\"heap\"})",
          "refId": "A",
          "legendFormat": "{{service_name}}/{{host_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "GC time / sec (driver vs executors)",
      "description": "Sustained GC > 0.1s/s = JVM in trouble.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (service_name) (rate(jvm_gc_duration_seconds_sum{service_name=~\"spark-.*\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "CPU utilization (driver vs executors)",
      "description": "Executors spike during a micro-batch (~60s trigger) and drop near 0 between epochs. The driver stays light — it only orchestrates and runs foreachBatch's Postgres upsert. Sustained executor CPU near 1.0 = under-provisioned for the producer rate.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "avg by (service_name) (jvm_cpu_recent_utilization_ratio{service_name=~\"spark-.*\"})",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Thread count",
      "description": "Steady growth = thread leak (rare in Spark). Sudden drop = process restart.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (service_name) (jvm_thread_count{service_name=~\"spark-.*\"})",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "drawStyle": "line"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    }
  ]
}