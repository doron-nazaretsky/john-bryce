{
  "uid": "postgres",
  "title": "30 \u00b7 Postgres",
  "tags": [
    "monitoring-lab"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "style": "dark",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "links": [
    {
      "title": "\u2190 Overview",
      "url": "/d/overview",
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "aggregated_clicks rows",
      "description": "Live tuples in the sink table. Grows over time as new minute_windows open — roughly distinct_products (≈20) × elapsed_minutes once the watermark has stabilized. New rows appear when a window first sees an event; thereafter the row's click_count is updated in place.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(postgresql_rows{postgresql_table_name=\"public.aggregated_clicks\",state=\"live\"})",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Write rate",
      "description": "Inserts + updates per second on aggregated_clicks. Each streaming epoch (~60s) does one executemany upsert: this rate reflects how many (product × minute_window) running totals changed in that epoch, divided by 60.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(postgresql_operations_total{postgresql_table_name=\"public.aggregated_clicks\",operation=~\"ins|upd\"}[1m]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Commits / sec",
      "description": "All committed transactions on the clicks database (not just aggregated_clicks writes). The pg_stat receiver itself counts here too, so the baseline is non-zero.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(postgresql_commits_total[1m]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DB size",
      "description": "On-disk size of the clicks database. Grows ~slowly with row count; not a hot-path signal but useful for spotting unbounded growth.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(postgresql_db_size_bytes{postgresql_database_name=\"clicks\"})",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Write operations / sec",
      "description": "Inserts vs updates vs deletes on aggregated_clicks. Upserts show as a mix of ins+upd.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(postgresql_operations_total{postgresql_table_name=\"public.aggregated_clicks\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 2,
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Rows over time",
      "description": "Cumulative live row count in aggregated_clicks.",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(postgresql_rows{postgresql_table_name=\"public.aggregated_clicks\",state=\"live\"})",
          "refId": "A",
          "legendFormat": "rows"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Commits vs rollbacks (transactions/sec)",
      "description": "Rollbacks > 0 means failed transactions. Healthy lab = 100% commits.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(postgresql_commits_total[1m]))",
          "refId": "A",
          "legendFormat": "commits"
        },
        {
          "expr": "sum(rate(postgresql_rollbacks_total[1m]))",
          "refId": "B",
          "legendFormat": "rollbacks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "opacity"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "commits"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "semi-dark-green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rollbacks"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "semi-dark-red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Cache hit ratio (1 - disk reads / total reads)",
      "description": "Drops = working set no longer fits in shared_buffers.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(postgresql_blocks_read_total{source=\"disk\"}[2m])) / clamp_min(sum(rate(postgresql_blocks_read_total[2m])), 1))",
          "refId": "A",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        }
      }
    }
  ]
}